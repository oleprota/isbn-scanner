{
  "name": "isbn-scanner",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "check:syntax": "git ls-files --cached --others --exclude-standard -z '*.js' '*.mjs' ':!vendor' | xargs -0 -n1 sh -c '[ ! -f \"$0\" ] || node --check \"$0\"'",
    "check:tests": "node --test --test-reporter=./scripts/failures-reporter.mjs",
    "check": "npm run check:syntax && npm run check:tests"
  }
}
