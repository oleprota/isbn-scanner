{
  "manifest_version": 3,
  "name": "Сканер ISBN: книга на сторінці",
  "version": "1.0.0",
  "description": "Рейтинг Goodreads і посилання на Ereadian для книги на поточній сторінці.",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "favicon"],
  "host_permissions": ["https://isbn-lookup.oleprota.workers.dev/*"],
  "optional_host_permissions": ["*://*/*"],
  "web_accessible_resources": [{ "resources": ["icons/*.png"], "matches": ["http://*/*", "https://*/*"] }],
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Показати книгу на сторінці" }
}
